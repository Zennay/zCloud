{
  "schema_version": 1,
  "default": {
    "mode": "ai_worker",
    "auto_start": true,
    "continue_delay_seconds": 120,
    "wait_vps_seconds": 900,
    "wait_human_seconds": 21600,
    "complete_recheck_seconds": 86400,
    "dispatch_mode": "vps",
    "min_ai_interval_seconds": 120,
    "autonomy_contract_required": true
  },
  "projects": {
    "cloud": {
      "mode": "zcloud_stopgate",
      "auto_start": true,
      "continue_delay_seconds": 120,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 120
    },
    "haxlab": {
      "mode": "haxlab_status",
      "auto_start": true,
      "status_file": "/var/lib/haxlab/state/autonomy-status.json",
      "ai_states": [],
      "continue_delay_seconds": 120,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 120,
      "local_executor_owns_states": true,
      "status_missing_fail_closed": true
    },
    "ftmo": {
      "mode": "ftmo_status",
      "auto_start": true,
      "status_file": "/opt/ftmo-autonomous/.scratch/autonomy/status.json",
      "ai_stages": [],
      "continue_delay_seconds": 120,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 120,
      "local_executor_owns_stages": true,
      "status_missing_fail_closed": true
    },
    "ulab": {
      "mode": "external_gate",
      "auto_start": false,
      "continue_delay_seconds": 120,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 120
    },
    "supa": {
      "mode": "ai_worker",
      "auto_start": true,
      "continue_delay_seconds": 120,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 120
    },
    "raiseai": {
      "mode": "ai_worker",
      "auto_start": true,
      "continue_delay_seconds": 120,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 120
    },
    "zssh": {
      "mode": "ai_worker",
      "auto_start": true,
      "continue_delay_seconds": 120,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 120
    },
    "lightup": {
      "mode": "ai_worker",
      "auto_start": true,
      "continue_delay_seconds": 120,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 120
    }
  }
}
