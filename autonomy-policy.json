{
  "schema_version": 1,
  "default": {
    "mode": "ai_worker",
    "auto_start": true,
    "continue_delay_seconds": 0,
    "wait_vps_seconds": 900,
    "wait_human_seconds": 21600,
    "complete_recheck_seconds": 86400,
    "dispatch_mode": "vps",
    "min_ai_interval_seconds": 0
  },
  "projects": {
    "cloud": {
      "mode": "zcloud_stopgate",
      "auto_start": true,
      "continue_delay_seconds": 0,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 0
    },
    "haxlab": {
      "mode": "haxlab_status",
      "auto_start": true,
      "status_file": "/var/lib/haxlab/state/autonomy-status.json",
      "ai_states": [
        "NEEDS_AI"
      ],
      "continue_delay_seconds": 0,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 0
    },
    "ftmo": {
      "mode": "ftmo_status",
      "auto_start": true,
      "status_file": "/opt/ftmo-autonomous/.scratch/autonomy/status.json",
      "ai_stages": [
        "provider_foundation",
        "freeze_data_split",
        "await_preregistration",
        "development",
        "development_review",
        "close_development_reject",
        "walk_forward",
        "close_walk_forward_reject",
        "final_holdout",
        "close_validated",
        "next_generation_design"
      ],
      "continue_delay_seconds": 0,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 0
    },
    "ulab": {
      "mode": "external_gate",
      "auto_start": false,
      "continue_delay_seconds": 0,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 0
    },
    "supa": {
      "mode": "ai_worker",
      "auto_start": true,
      "continue_delay_seconds": 0,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 0
    },
    "raiseai": {
      "mode": "ai_worker",
      "auto_start": true,
      "continue_delay_seconds": 0,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 0
    },
    "zssh": {
      "mode": "ai_worker",
      "auto_start": true,
      "continue_delay_seconds": 0,
      "dispatch_mode": "vps",
      "min_ai_interval_seconds": 0
    }
  }
}
