# Development only. Production auth is a later milestone.
ZSSH_DEV_BEARER_TOKEN=replace-me

# Comma-separated filesystem roots accessible to file tools and command cwd.
ZSSH_ALLOWED_ROOTS=/home/ubuntu/zennay-cloud

# safe = destructive commands blocked; full = destructive commands allowed by server policy.
ZSSH_EXEC_MODE=safe

# Hard limits.
ZSSH_COMMAND_TIMEOUT_SECONDS=30
ZSSH_MAX_OUTPUT_BYTES=131072
ZSSH_MAX_FILE_BYTES=131072

PORT=8788
