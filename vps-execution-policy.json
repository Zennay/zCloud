{
  "schema_version": 1,
  "id": "zcloud-vps-execution-lane",
  "enabled": true,
  "transport": "github-actions-self-hosted-runner",
  "runner": {
    "labels": [
      "self-hosted"
    ],
    "host": "vps-bb300bba",
    "user": "ubuntu",
    "workspace": "/home/ubuntu"
  },
  "projects": [
    "haxlab",
    "ftmo",
    "cloud",
    "supa",
    "raiseai",
    "ulab",
    "zssh"
  ],
  "capabilities": [
    "local-shell",
    "ssh-client",
    "git",
    "package-install",
    "systemd-user",
    "docker-when-installed",
    "filesystem",
    "process-inspection"
  ],
  "execution_rules": {
    "preferred_for": [
      "installations",
      "package-management",
      "builds",
      "tests",
      "deployments",
      "service-restarts",
      "filesystem-changes",
      "SSH-to-configured-targets"
    ],
    "interactive_ssh": "unsupported_as_a_persistent_session; use_a_bounded_job_or_service",
    "destructive_operations": "require_explicit_confirmation_and_machine-readable_evidence",
    "secrets": "use_runner_environment_or_GitHub_secrets; never_put_secrets_in_prompts_or_logs",
    "completion_evidence": [
      "workflow_run_id",
      "exit_code",
      "sanitized_stdout_stderr",
      "changed_files_or_service_state"
    ]
  },
  "prompt_directive": "CENTRALE VPS/SSH-ROUTE: gebruik voor shell, builds, tests, deploys en servicewerk de zCloud GitHub self-hosted runner op vps-bb300bba en leg runner/workflow-id plus resultaat vast. ZCLOUD_AUTONOMY: WAIT_VPS is verboden zolang deze veilige runner-route nog geprobeerd kan worden. Ontbrekende directe SSH is geen blocker. Vraag bevestiging voor destructieve/brede wijzigingen en zet nooit secrets in prompts of logs."
}
