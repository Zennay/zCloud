{
  "schema_version": 1,
  "id": "zcloud-vps-execution-lane",
  "enabled": true,
  "transport": "github-actions-self-hosted-runner",
  "runner": {
    "labels": [
      "self-hosted"
    ],
    "host": "vps-bb300bba",
    "user": "ubuntu",
    "workspace": "/home/ubuntu",
    "forbidden_name_tokens": [
      "haxlab"
    ],
    "identity_guard": "scripts/zcloud_vps_runner_guard.py"
  },
  "projects": [
    "haxlab",
    "ftmo",
    "cloud",
    "supa",
    "raiseai",
    "ulab",
    "zssh",
    "lightup"
  ],
  "capabilities": [
    "local-shell",
    "ssh-client",
    "git",
    "package-install",
    "systemd-user",
    "docker-when-installed",
    "filesystem",
    "process-inspection"
  ],
  "execution_rules": {
    "preferred_for": [
      "installations",
      "package-management",
      "builds",
      "tests",
      "deployments",
      "service-restarts",
      "filesystem-changes",
      "SSH-to-configured-targets"
    ],
    "interactive_ssh": "unsupported_as_a_persistent_session; use_a_bounded_job_or_service",
    "destructive_operations": "require_explicit_confirmation_and_machine-readable_evidence",
    "secrets": "use_runner_environment_or_GitHub_secrets; never_put_secrets_in_prompts_or_logs",
    "completion_evidence": [
      "workflow_run_id",
      "exit_code",
      "sanitized_stdout_stderr",
      "changed_files_or_service_state"
    ]
  },
  "prompt_directive": "VPS: shell/build/test/deploy via GitHub Actions op self-hosted vps-bb300bba; leg workflow_run_id + resultaat vast. WAIT_VPS niet gebruiken als deze route kan. Vraag alleen bevestiging voor destructieve/brede wijzigingen; geen secrets in prompts/logs."
}
