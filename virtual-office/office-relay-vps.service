[Unit]
Description=Virtual Office dedicated ChatGPT Relay Firefox (VPS RDP desktop)
After=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
Environment=DISPLAY=:10
Environment=XAUTHORITY=/home/ubuntu/.Xauthority
Environment=MOZ_ENABLE_WAYLAND=0
ExecStart=/bin/bash /opt/virtual-office/office-relay-vps.sh
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
