{
  "schema_version": 1,
  "purpose": "Fail-closed contract vectors for PR-less branch pagination admission (#1164). Data fixtures only; not wired into production.",
  "snapshot": {
    "main_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "open_pr_head_branches": [
      "pr-already-present"
    ],
    "max_pages": 3,
