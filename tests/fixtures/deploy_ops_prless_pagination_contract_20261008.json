    {
      "id": "max-pages-exhausted",
      "pages": [
        {
          "cursor_in": null,
          "cursor_out": "2",
          "branches": [
            "safe-a"
          ]
        },
        {
          "cursor_in": "2",
          "cursor_out": "3",
          "branches": [
            "safe-b"
          ]
        },
        {
          "cursor_in": "3",
          "cursor_out": "4",
          "branches": [
            "safe-c"
          ]
        }
      ],
      "expect": {
        "inventory_complete": false,
        "admission": "deny"
      }
    },
    {
      "id": "main-sha-drift",
      "pages": [
        {
          "cursor_in": null,
          "cursor_out": null,
          "branches": [
            "safe-a"
          ]
        }
      ],
      "final_main_sha": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "expect": {
        "inventory_complete": false,
        "admission": "deny"
      }
    },
    {
      "id": "pr-head-deduplication",
      "pages": [
        {
          "cursor_in": null,
          "cursor_out": null,
          "branches": [
            "pr-already-present",
