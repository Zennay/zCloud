  },
  "cases": [
    {
      "id": "second-page-overlap",
      "pages": [
        {
          "cursor_in": null,
          "cursor_out": "next-1",
          "branches": [
            "safe-a"
          ]
        },
        {
          "cursor_in": "next-1",
          "cursor_out": null,
          "branches": [
            "overlap-owned"
          ]
        }
      ],
      "owned_paths": [
        ".github/workflows/zcloud-vps-deploy.yml"
      ],
      "branch_changed_paths": {
        "safe-a": [
          "docs/isolated.md"
        ],
        "overlap-owned": [
          ".github/workflows/zcloud-vps-deploy.yml"
        ]
      },
      "expect": {
        "inventory_complete": true,
        "admission": "deny",
        "reason": "overlap"
      }
    },
    {
      "id": "duplicate-cursor",
      "pages": [
        {
          "cursor_in": null,
          "cursor_out": "same",
          "branches": [
            "safe-a"
          ]
        },
        {
          "cursor_in": "same",
          "cursor_out": "same",
          "branches": [
            "safe-b"
          ]
        }
      ],
      "expect": {
        "inventory_complete": false,
        "admission": "deny",
        "reason": "cursor_cycle"
      }
    },
    {
      "id": "empty-last-page",
      "pages": [
        {
          "cursor_in": null,
          "cursor_out": "last",
          "branches": [
            "safe-a"
          ]
        },
        {
          "cursor_in": "last",
          "cursor_out": null,
          "branches": []
        }
      ],
      "expect": {
        "inventory_complete": true,
        "admission": "clear"
      }
    },
    {
      "id": "failure-after-first-page",
      "pages": [
        {
          "cursor_in": null,
          "cursor_out": "next",
          "branches": [
            "safe-a"
          ]
        },
        {
          "cursor_in": "next",
          "error": "api_unavailable"
        }
      ],
      "expect": {
        "inventory_complete": false,
        "admission": "deny"
      }
