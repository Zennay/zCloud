{
  "manifest_version": 2,
  "name": "ChatGPT Project Runner",
  "version": "0.9.2",
  "permissions": [
    "tabs",
    "sessions",
    "storage",
    "https://chatgpt.com/*",
    "https://claude.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "scripts": [
      "recovery.js",
      "background.js",
      "worker-controller-v2.js"
    ],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "project-runner-v07@local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "worker-identity.js"
      ],
      "run_at": "document_start"
    }
  ]
}
